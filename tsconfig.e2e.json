{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": [
    "tests/e2e/**/*",
    "tests/e2e-packaged/**/*",
    "tests/helpers/**/*",
    "src/shared/**/*",
    "src/main/**/*",
    "playwright.config.ts",
    "tests/summary-reporter-playwright.ts"
  ]
}
